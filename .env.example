# 107 Workspace environment variable template.
#
# Local development: copy this file to backend/.env.
# Docker Compose:     copy this file to .env and set POSTGRES_PASSWORD.
#
# Real credentials and local .env files must never be committed.

# ---------- Application ----------
# local enables development CORS; production expects same-origin proxying.
WORKSPACE107_ENV=local
WORKSPACE107_LOG_LEVEL=INFO
# auto uses readable text locally and JSON elsewhere; explicit values: json | text.
WORKSPACE107_LOG_FORMAT=auto
WORKSPACE107_MAX_REQUEST_BYTES=134217728
WORKSPACE107_MAX_FILE_BYTES=33554432

# ---------- Database and canonical storage ----------
WORKSPACE107_DATABASE_URL=sqlite+aiosqlite:///./var/workspace107.db
WORKSPACE107_STORAGE_ROOT=./var/storage
# Canonical storage root group, injected into API and Worker. Local default is 10001.
WORKSPACE107_STORAGE_GID=10001
# Run-tree sharing currently uses the same group; it is not cross-Run isolation.
WORKSPACE107_SHARED_GID=10001

# ---------- Worker scheduler (never inject into the API service) ----------
# mock executes commands on the Worker host and is allowed only for local/test use.
# slurm is mechanically disabled until a per-Run filesystem isolation contract is implemented.
WORKSPACE107_SCHEDULER=mock
WORKSPACE107_SLURM_API_BASE_URL=
WORKSPACE107_SLURM_API_USER=
# Secret: Worker-only runtime injection; never put a real JWT in this file.
WORKSPACE107_SLURM_JWT=
WORKSPACE107_SLURM_TARGET_CLUSTER_ID=
WORKSPACE107_SLURM_API_VERSION=
WORKSPACE107_SLURM_API_SCHEMA_PROFILE=
WORKSPACE107_SLURM_SUBMIT_PATH=
WORKSPACE107_SLURM_JOB_PATH_TEMPLATE=
WORKSPACE107_SLURM_JOBS_PATH=
WORKSPACE107_SLURM_CANCEL_PATH_TEMPLATE=
WORKSPACE107_SLURM_CORRELATION_FIELD=
WORKSPACE107_SLURM_CORRELATION_QUERY_PARAMETER=
# Set true only after exact filtering, permission and complete pagination are evidenced.
WORKSPACE107_SLURM_CORRELATION_QUERY_COMPLETE=false
WORKSPACE107_SLURM_CORRELATION_MAX_BYTES=0
# Only native is implemented; it still requires the real-107 runtime gate.
WORKSPACE107_SLURM_RUNTIME_MODE=native
WORKSPACE107_SLURM_TIMEOUT_SECONDS=20
WORKSPACE107_WORKER_POLL_SECONDS=1.0
WORKSPACE107_WORKER_IDLE_SECONDS=0.5

# ---------- Authentication ----------
# dev trusts X-User for local work; ustc is the planned identity-provider mode.
WORKSPACE107_AUTH_MODE=dev

# ---------- Docker Compose only ----------
POSTGRES_DB=workspace107
POSTGRES_USER=workspace107
# Required by Compose. Leave empty in the committed template.
POSTGRES_PASSWORD=
WORKSPACE107_HTTP_PORT=8107

# Local image identity defaults only. Real 107 values require human validation and image rebuild.
WORKSPACE107_SERVICE_UID=10001
WORKSPACE107_SERVICE_GID=10001
# Named volume by default. API and Worker mount it at the same canonical container path.
# A real Slurm deployment must map that exact path to the same shared content on compute nodes.
WORKSPACE107_STORAGE_MOUNT=storage-data
WORKSPACE107_SEED_DEMO=false
# Local/demo bootstrap only; persisted active Owner Membership remains authoritative.
WORKSPACE107_DEMO_PLATFORM_OWNER_USERNAME=student
WORKSPACE107_IMAGE_API=workspace107/api:local
WORKSPACE107_IMAGE_WEB=workspace107/web:local

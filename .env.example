# 107 Workspace environment variable template.
#
# Local development: copy this file to backend/.env.
# Docker Compose:     copy this file to .env and set POSTGRES_PASSWORD.
#
# Real credentials and local .env files must never be committed.

# ---------- Application ----------
# local enables the development CORS origins; production expects same-origin proxying.
WORKSPACE107_ENV=local
WORKSPACE107_LOG_LEVEL=INFO
# auto uses readable text locally and JSON elsewhere; explicit values: json | text.
WORKSPACE107_LOG_FORMAT=auto
WORKSPACE107_MAX_REQUEST_BYTES=134217728
WORKSPACE107_MAX_FILE_BYTES=33554432

# ---------- Database and storage ----------
WORKSPACE107_DATABASE_URL=sqlite+aiosqlite:///./var/workspace107.db
WORKSPACE107_STORAGE_ROOT=./var/storage

# ---------- Scheduler ----------
# mock executes submitted commands on the application host and is only for development/demo.
# Internet-facing deployments must use the separately validated slurm integration.
WORKSPACE107_SCHEDULER=mock
WORKSPACE107_SLURM_API_BASE_URL=
WORKSPACE107_SLURM_API_USER=
# Secret: inject at runtime; never put a real JWT in this file.
WORKSPACE107_SLURM_JWT=

# Set to 0 to disable background reconciliation and trigger it explicitly.
WORKSPACE107_RUN_SYNC_INTERVAL_SECONDS=1.0
# Shared Resource publication is independent from Run reconciliation.
WORKSPACE107_SHARED_RESOURCE_PUBLICATION_INTERVAL_SECONDS=1.0
# A processing claim older than this is safely reclaimable after restart.
WORKSPACE107_SHARED_RESOURCE_PUBLICATION_RECOVERY_SECONDS=300.0

# ---------- Authentication ----------
# ustc: make dev shows the public login page (auth process + Vite auth_request proxy).
# dev: skip login; the browser is already signed in as `student`.
# Compose web has no /login — keep AUTH_MODE=dev in the Compose root .env.
# See docs/operations/authentication.md.
WORKSPACE107_AUTH_MODE=ustc

# Browser origin opened by `make dev`. Must match the URL in the address bar.
WORKSPACE107_PUBLIC_ORIGIN=http://127.0.0.1:5174
# Flask session signing key. Required when AUTH_MODE=ustc. Do not commit real values.
WORKSPACE107_AUTH_SECRET_KEY=change-me
# 0 for local HTTP; 1 when the public origin is HTTPS.
WORKSPACE107_SESSION_COOKIE_SECURE=0
# Outbound proxy for CAS serviceValidate. Empty is OK for password-only login.
WORKSPACE107_HTTPS_PROXY=
WORKSPACE107_CAS_LOGIN_URL=https://passport.ustc.edu.cn/login
WORKSPACE107_CAS_VALIDATE_URL=https://passport.ustc.edu.cn/serviceValidate

# Local password login. Only for trusted demo; do not commit a real password.
WORKSPACE107_LOCAL_ADMIN_USERNAME=platform-admin
WORKSPACE107_LOCAL_ADMIN_DISPLAY_NAME=平台管理员
WORKSPACE107_LOCAL_ADMIN_PASSWORD=
WORKSPACE107_LOCAL_ADMIN_PASSWORD_HASH=

# make dev defaults. Override if 8000/5174/8108 are already taken.
WORKSPACE107_BACKEND_ORIGIN=http://127.0.0.1:8000
WORKSPACE107_AUTH_ORIGIN=http://127.0.0.1:8108
WORKSPACE107_AUTH_PORT=8108

# ---------- Docker Compose only ----------
POSTGRES_DB=workspace107
POSTGRES_USER=workspace107
# Required by Compose. Leave empty in the committed template.
POSTGRES_PASSWORD=
WORKSPACE107_HTTP_PORT=8107

# Named volume by default. This is mounted at /var/lib/workspace107/storage in the API container.
# A Slurm deployment must expose the same shared content at that path on every compute node.
WORKSPACE107_STORAGE_MOUNT=storage-data
WORKSPACE107_SEED_DEMO=false
# Local/demo bootstrap only. Used only when grp_platform_assets does not exist;
# later seed runs preserve the persisted active Owner Membership.
WORKSPACE107_DEMO_PLATFORM_OWNER_USERNAME=student
WORKSPACE107_IMAGE_API=workspace107/api:local
WORKSPACE107_IMAGE_WEB=workspace107/web:local

# 浏览器访问入口。必须固定配置，不能从 Host / X-Forwarded-* 推导。
PUBLIC_ORIGIN=http://127.0.0.1:8107

# Flask 会话签名密钥，按部署单独生成，不要提交真实值。
SECRET_KEY=change-me

# 本次 HTTP 隧道联调关闭 Secure；后续 HTTPS 入口必须设为 1。
SESSION_COOKIE_SECURE=0

# 显式出站代理，供 CAS serviceValidate 使用。不要依赖交互 shell 的隐式环境。
# 只演示账密登录、没有可用代理时可以留空；此时统一身份认证校验会失败。
HTTPS_PROXY=http://127.0.0.1:27997

CAS_LOGIN_URL=https://passport.ustc.edu.cn/login
CAS_VALIDATE_URL=https://passport.ustc.edu.cn/serviceValidate

# 受信任演示的本地管理员。只用于管理「平台资产」User Group，不是 Platform Admin 控制台。
# 优先使用 HASH；仅演示环境可改用明文 LOCAL_ADMIN_PASSWORD。
LOCAL_ADMIN_USERNAME=platform-admin
LOCAL_ADMIN_DISPLAY_NAME=平台管理员
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_PASSWORD_HASH=

# 仓库内前端构建产物的绝对路径。先在仓库根目录执行 make build。
FRONTEND_DIST=/absolute/path/to/107-workspace/frontend/dist
BACKEND_ORIGIN=http://127.0.0.1:8000
AUTH_ORIGIN=http://127.0.0.1:8108
NGINX_LISTEN=127.0.0.1:8107

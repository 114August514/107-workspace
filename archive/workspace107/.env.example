# 107 Workspace 环境变量示例
#
# 两种用法，变量名相同：
#
#   本地开发   cp .env.example backend/.env
#   容器部署   cp .env.example .env      （docker compose 读仓库根目录的 .env）
#
# .env 已被 .gitignore 和 .dockerignore 排除。任何真实值都不得提交，
# 也不会进入镜像。

# ============================================================
# 应用
# ============================================================

# local      本地开发，会为 http://127.0.0.1:5173 放开 CORS
# production 前后端同源，不需要 CORS
#
# 容器部署不读这一项：docker-compose 里写死 production，
# 避免把开发用的 CORS 设置带进容器。
WORKSPACE107_ENV=local
WORKSPACE107_LOG_LEVEL=INFO

# auto  本地开发输出可读文本，其余环境输出 JSON 便于采集
# json  始终输出结构化日志
# text  始终输出可读文本
WORKSPACE107_LOG_FORMAT=auto

# 请求体上限：在读进内存之前按 Content-Length 拦掉（字节）
WORKSPACE107_MAX_REQUEST_BYTES=134217728
# 单个 Project 文件上限（字节）。数据集和模型权重属于算力平台存储，
# 不该塞进 Project 文件。
WORKSPACE107_MAX_FILE_BYTES=33554432

# ============================================================
# 数据库
# ============================================================

# 本地开发默认 SQLite；容器部署由 docker-compose 自动拼成 PostgreSQL 地址，
# 不需要在这里填写。
WORKSPACE107_DATABASE_URL=sqlite+aiosqlite:///./var/workspace107.db

# ============================================================
# 存储
# ============================================================

# Project 文件、Run 工作目录、日志和 Artifact 的根目录。
WORKSPACE107_STORAGE_ROOT=./var/storage

# ============================================================
# 调度
# ============================================================

# mock  本机子进程真实执行，用于开发、测试和演示
# slurm 通过 Slurm REST API 提交到真实集群
#
# 警告：mock 会在服务进程里执行用户代码，任何能提交 Run 的人都能执行任意命令。
# 对外提供服务必须使用 slurm。
WORKSPACE107_SCHEDULER=mock

WORKSPACE107_SLURM_API_BASE_URL=
WORKSPACE107_SLURM_API_USER=
# Slurm JWT 等价于密码，只能通过环境变量注入，禁止写入代码或提交仓库。
WORKSPACE107_SLURM_JWT=

# ============================================================
# 认证
# ============================================================

# dev  通过 X-User 请求头识别用户，仅用于本地开发和内部演示
# ustc 对接学校统一身份认证（V1）
WORKSPACE107_AUTH_MODE=dev

# ============================================================
# 以下仅用于容器部署（docker compose）
# ============================================================

# 数据库凭据。POSTGRES_PASSWORD 没有默认值，不填 compose 会直接报错退出。
POSTGRES_DB=workspace107
POSTGRES_USER=workspace107
POSTGRES_PASSWORD=

# 对外暴露的端口，浏览器访问 http://<主机>:<端口>
WORKSPACE107_HTTP_PORT=8107

# Run 工作目录的挂载来源。
#
# 默认 storage-data 是 Docker 命名卷，只在本机可见，适合 mock 调度器。
#
# 接真实 Slurm 集群时必须改成集群共享存储的路径，例如
#   WORKSPACE107_STORAGE_MOUNT=/public/workspace107/storage
# 因为 api 容器准备的工作目录必须能被计算节点读写。
WORKSPACE107_STORAGE_MOUNT=storage-data

# 启动时是否额外载入演示 Project。平台目录（运行环境、算力方案）
# 无论如何都会载入，它是应用能工作的前提。
WORKSPACE107_SEED_DEMO=false

# 镜像名。本地构建保持默认；使用已发布镜像时改成 GHCR 上的地址，例如
#   WORKSPACE107_IMAGE_API=ghcr.io/ustc-107/workspace107-api:v0.1.0
WORKSPACE107_IMAGE_API=workspace107/api:local
WORKSPACE107_IMAGE_WEB=workspace107/web:local

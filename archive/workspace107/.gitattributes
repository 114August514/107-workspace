# 自动识别文本文件，并在仓库中统一使用 LF 换行符
* text=auto eol=lf

# 明确常用文本文件
*.sh text eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.mako text eol=lf
Dockerfile text eol=lf

# 常见二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# 生成物在 diff 中折叠，但仍然提交
backend/uv.lock linguist-generated=true
frontend/package-lock.json linguist-generated=true
docs/api/openapi.json linguist-generated=true
frontend/src/api/schema.d.ts linguist-generated=true

# Git LFS
# 目前没有需要 LFS 管理的文件。
# 新增规则必须限定目录，并经过 Pull Request 评审，例如：
#   git lfs track "docs/demo/*.mp4"

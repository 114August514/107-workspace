# Store text with LF so Linux, WSL, and Windows contributors see the same content.
* text=auto eol=lf

*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sql text eol=lf
*.mako text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# Generated files remain committed but are folded in GitHub language statistics.
backend/uv.lock linguist-generated=true
frontend/pnpm-lock.yaml linguist-generated=true
docs/api/openapi.json linguist-generated=true
frontend/src/api/schema.d.ts linguist-generated=true

# The two preserved platform source documents are managed through Git LFS.
docs/references/platform/107-cluster-competition-training.pdf filter=lfs diff=lfs merge=lfs -text
docs/references/platform/computing-platform-track-introduction.pdf filter=lfs diff=lfs merge=lfs -text
